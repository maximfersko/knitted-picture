<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Глубокий тестировщик (QA-бот): играет на настоящем ядре игры разными «личностями», после каждого
    действия сверяет десятки правил-оракулов, гоняет пограничные уровни, ужимает найденную ошибку до
    минимального воспроизведения (ddmin), рисует «скриншоты» состояния и собирает отчёт HTML/JSON.
    Как запускать — docs/QA.md и Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>KnittedPicture.QA</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../KnittedPicture.Core/KnittedPicture.Core.csproj" />
    <ProjectReference Include="../KnittedPicture.LevelTool/KnittedPicture.LevelTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Растр и PNG: те же, что рисуют спрайты игры и превью. -->
    <Compile Include="../../Assets/Scripts/Game/Art/Raster.cs" Link="Art/Raster.cs" />
    <Compile Include="../KnittedPicture.ArtPreview/Png.cs" Link="Art/Png.cs" />
  </ItemGroup>

</Project>
