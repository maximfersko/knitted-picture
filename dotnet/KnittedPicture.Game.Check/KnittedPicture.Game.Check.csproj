<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проверка компиляции кода игры без Unity Editor: справочные сборки движка из NuGet
    и заглушки uGUI (UguiStubs.cs). Ничего не запускает — только ловит ошибки компиляции.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0067;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KnittedPicture.Core/KnittedPicture.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Game/**/*.cs" Link="Game/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="UguiStubs.cs" />
  </ItemGroup>

</Project>
